{
  "name": "@gaborwnuk/axs-core",
  "version": "0.1.0",
  "description": "Read live state — including current gear — from SRAM AXS components over Bluetooth Low Energy. Zero runtime dependencies; runs under Node, Hermes and the browser.",
  "keywords": [
    "sram",
    "axs",
    "eagle",
    "transmission",
    "bicycle",
    "cycling",
    "derailleur",
    "drivetrain",
    "ble",
    "bluetooth",
    "bluetooth-low-energy",
    "gatt",
    "react-native"
  ],
  "license": "MPL-2.0",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "react-native": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^3.2.4",
    "tsup": "^8.5.0",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  },
  "author": "Gabor Wnuk <gabor.wnuk@me.com>",
  "homepage": "https://github.com/GaborWnuk/sram-axs#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GaborWnuk/sram-axs.git",
    "directory": "packages/axs-core"
  },
  "bugs": {
    "url": "https://github.com/GaborWnuk/sram-axs/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  }
}
