{
  "name": "sram-axs-workspace",
  "private": true,
  "version": "0.0.0",
  "description": "Monorepo: axs-core BLE reconnaissance/decoding library + Expo demo app for SRAM AXS components",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "npm run build --workspace=@gaborwnuk/axs-core",
    "test": "npm run test --workspace=@gaborwnuk/axs-core",
    "test:watch": "npm run test:watch --workspace=@gaborwnuk/axs-core",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "demo": "npm run start --workspace=@gaborwnuk/axs-demo",
    "cli": "npm run axs -w @gaborwnuk/axs-cli --",
    "scan": "npm run axs -w @gaborwnuk/axs-cli -- scan",
    "lint:fix": "eslint . --fix",
    "check": "npm run build && npm run lint && npm run typecheck && npm run typecheck:lib && npm test && npm run check:docs && npm run check:pipeline",
    "check:pipeline": "npm run cli -- simulate --seconds 5 --assert",
    "check:docs": "node scripts/check-docs.mjs",
    "typecheck:lib": "npm run typecheck:lib --workspaces --if-present"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "globals": "^17.11.0",
    "typescript-eslint": "^8.67.0"
  },
  "license": "MPL-2.0",
  "author": "Gabor Wnuk <gabor.wnuk@me.com>"
}
